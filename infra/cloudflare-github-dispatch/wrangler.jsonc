{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scrape2lead-github-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "triggers": {
    // Должен совпадать один-в-один с WORKFLOW_BY_CRON в src/index.ts:
    // workflowForCron бросает на неизвестном кроне, поэтому расхождение падает в рантайме.
    "crons": [
      "40 3 * * *",
      "10 4 * * *",
      "0 5 * * *",
      "30 6 * * *",
      "0 8 * * *",
      "30 9 * * *"
    ]
  },
  "secrets": {
    "required": [
      "GITHUB_ACTIONS_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
