{
  "name": "scrape2lead",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.json --noEmit",
    "cloudflare:check": "wrangler deploy --dry-run --config infra/cloudflare-github-dispatch/wrangler.jsonc",
    "cloudflare:dev": "wrangler dev --test-scheduled --config infra/cloudflare-github-dispatch/wrangler.jsonc",
    "cloudflare:secret": "wrangler secret put GITHUB_ACTIONS_TOKEN --config infra/cloudflare-github-dispatch/wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config infra/cloudflare-github-dispatch/wrangler.jsonc",
    "cloudflare:tail": "wrangler tail --config infra/cloudflare-github-dispatch/wrangler.jsonc",
    "automation:prepare": "tsx scripts/automation.mts prepare",
    "automation:run": "tsx scripts/automation.mts run",
    "automation:f3": "tsx scripts/automation.mts run --config config/automation.f3.json",
    "f3:export": "tsx scripts/kz-export-procurement.mts --config config/procurement-sources.f3.json",
    "f3:push": "tsx scripts/bitrix-push-procurement.mts --config config/procurement-sources.f3.json",
    "f3:audit": "tsx scripts/bitrix-audit-procurement-cards.mts",
    "f3:remediate": "tsx scripts/bitrix-remediate-procurement-cards.mts",
    "automation:push": "tsx scripts/automation.mts push",
    "automation:approve": "tsx scripts/automation.mts approve",
    "automation:status": "tsx scripts/automation.mts status",
    "automation:run:sh": "sh scripts/run-automation.sh",
    "automation:install-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-automation-task.ps1",
    "automation:install-pk-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-automation-task.ps1 -TaskName \"Scrape2Lead Daily PK Plans\" -At 08:40 -ConfigPath config/automation.pk.json -LogPath runs/pk/scheduler.log -Description \"Prepare and push Scrape2Lead PK GZ plans to Bitrix (no lots, no AI)\"",
    "kz:export-gz-plans": "tsx scripts/kz-export-gz-plans.mts",
    "kz:export-lots-nstru": "tsx scripts/kz-export-goszakup-lots-by-nstru.mts",
    "kz:export-lots-computers": "tsx scripts/kz-export-goszakup-lots-by-nstru.mts --config config/gz-lots-computers.json",
    "kz:export-gz-contracts": "tsx scripts/kz-export-goszakup-contracts.mts",
    "kz:export-leads-it": "tsx scripts/kz-export-leads-it.mts",
    "kz:propose-lead-codes": "tsx scripts/kz-propose-lead-codes.mts",
    "kz:dedupe-gz-plans": "tsx scripts/dedupe-gz-plans-xlsx.mts",
    "kz:bitrix-push-gz-plans": "tsx scripts/bitrix-push-gz-plans.mts",
    "kz:monitor-gz-published": "tsx scripts/check-gz-deals-published.mts",
    "kz:monitor-gz-published-leads": "tsx scripts/kz-monitor-gz-published.mts",
    "bitrix:delete-gz-leads-by-assignee": "tsx scripts/bitrix-delete-gz-leads-by-assignee.mts",
    "bitrix:import": "tsx scripts/bitrix-import.mts",
    "bitrix:report": "tsx scripts/bitrix-report.mts",
    "bitrix:activity-audit": "tsx scripts/bitrix-activity-audit.mts",
    "bitrix:apply-procurement-layout": "tsx scripts/bitrix-apply-procurement-layout.mts",
    "bitrix:reassign-procurement-deals": "tsx scripts/bitrix-reassign-procurement-deals.mts",
    "bitrix:backfill-gz-origin": "tsx scripts/bitrix-backfill-gz-origin.mts",
    "bitrix:backfill-gz-plan-number": "tsx scripts/bitrix-backfill-gz-plan-number.mts",
    "bitrix:correct-gz-plan-number": "tsx scripts/bitrix-correct-gz-plan-number.mts",
    "bitrix:gz-duplicate-hygiene": "tsx scripts/bitrix-gz-duplicate-hygiene.mts",
    "bitrix:migrate-gz-categories": "tsx scripts/bitrix-migrate-gz-categories.mts",
    "kz:bitrix-push-gz-deals": "tsx scripts/bitrix-push-gz-deals.mts",
    "kz:bitrix-push-gz-lots": "tsx scripts/bitrix-push-gz-lots.mts",
    "kz:check-gz-deals-published": "tsx scripts/check-gz-deals-published.mts",
    "kz:analyze-gz-specs": "tsx scripts/analyze-gz-specs.mts",
    "kz:check-counterparties": "tsx scripts/kz-check-counterparties.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@e965/xlsx": "^0.20.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "playwright": "^1.52.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.18",
    "@vitest/coverage-v8": "^3.2.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "4.76.0"
  },
  "engines": {
    "node": ">=20"
  }
}
