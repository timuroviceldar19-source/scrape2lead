# Proxy rotation API endpoint.
# GET this URL to receive a new proxy вЂ” response may be JSON or plain text.
# Leave blank to run without automatic proxy rotation.
PROXY_API_URL=

# Static proxy fallback (used when PROXY_API_URL is not set).
# Format: http://host:port  or  socks5://host:port
PROXY_SERVER=

# Credentials for the proxy server above (optional).
PROXY_USERNAME=
PROXY_PASSWORD=

# Storage backend selector: "sqlite" (default) or "postgres".
STORAGE_BACKEND=sqlite

# Postgres connection string used when STORAGE_BACKEND=postgres.
# Example: postgres://user:password@localhost:5432/scrape2lead
POSTGRES_CONNECTION_STRING=

# Legacy safety gate for archived 2GIS scripts that hit the live proxy.
# Required only when running scripts from scripts/archive/ directly.
ALLOW_LIVE_PROXY_RUN=

# 2GIS Places API key for live 2GIS smoke and legacy 2GIS scripts.
# 2GIS_API_KEY is the original name; TWOGIS_API_KEY is the modern alias.
TWOGIS_API_KEY=
2GIS_API_KEY=

# 2GIS / Kaspi API-capture debug logging. Set to "true" to log safe
# response metadata to stderr (no request/response bodies).
API_CAPTURE_DEBUG=

# KZ pipeline вЂ” goszakup.
GOSZAKUP_TOKEN=
GOSZAKUP_MAX_PAGES=20
GOSZAKUP_HTML_MAX_PAGES=50
GOSZAKUP_PLAN_MAX_PAGES=50
GOSZAKUP_ACTIVE_STATUS_IDS=210,220
GOSZAKUP_REGISTRY_CACHE_TTL_DAYS=7

# KZ pipeline вЂ” stat.gov.
STAT_GOV_SESSION_PATH=data/stat-gov-session.json
STAT_GOV_CACHE_TTL_DAYS=7

# KZ pipeline вЂ” shared.
KZ_ENRICH_DELAY_MS=2000

# KZ pipeline вЂ” zakup.sk.kz (Playwright).
ZAKUP_MAX_RETRIES=3
ZAKUP_PAGE_TIMEOUT_MS=30000

# KZ / feeder / autopilot SQLite file.
# Default: data/scrape2lead.db. Used by scripts/kz-*.mts and the server's
# SCRAPE2LEAD_DATABASE_PATH.
KZ_DATABASE_PATH=data/scrape2lead.db

# Private Telegram notifications for the outreach autopilot
# (scripts/kz-autopilot.mts). Both must be set; otherwise the autopilot
# just warns and continues. This is a private chat for owner alerts вЂ”
# there is no public Telegram channel in this project.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scrape2Lead API server (npm run server / npm run server:dev).
SCRAPE2LEAD_HOST=127.0.0.1
SCRAPE2LEAD_PORT=8787
SCRAPE2LEAD_API_TOKEN=
SCRAPE2LEAD_MAX_CONCURRENT_JOBS=1
SCRAPE2LEAD_MAX_LOG_LINES=500
SCRAPE2LEAD_DATABASE_PATH=data/scrape2lead.db
SCRAPE2LEAD_CORS_ORIGIN=*
SCRAPE2LEAD_EXPORT_DIR=exports

# Legacy artifact fallback for GET /api/v1/artifacts: "1" / "true" / "yes"
# to also list top-level files from SCRAPE2LEAD_EXPORT_DIR. Off by default
# вЂ” turn on only during migration from the pre-JobStore read-from-FS API.
SCRAPE2LEAD_ARTIFACT_LEGACY_FALLBACK=

# Retention for api_jobs rows in the JobStore. Positive integer (days).
# When set, the server prunes terminal jobs (completed / failed / cancelled /
# interrupted) older than N days on startup, right after stale running jobs
# are marked interrupted. Queued and running jobs are never pruned. Related
# api_job_logs / api_job_artifacts rows are removed by ON DELETE CASCADE.
# Files under SCRAPE2LEAD_EXPORT_DIR are not touched. Leave empty or set to
# "0" to disable pruning.
SCRAPE2LEAD_JOB_RETENTION_DAYS=

# Retention for outreach_runs rows (scripts/kz-autopilot-retention.mts).
# Positive integer (days). Dry-run by default; pass --apply to delete eligible
# finished runs older than N days. outreach_seen / outreach_items are preserved.
# Leave empty or set to "0" to disable.
KZ_OUTREACH_RUN_RETENTION_DAYS=

# Bitrix24 inbound webhook for gz plans push.
# Example: https://your-domain.bitrix24.kz/rest/1/webhook-token/
BITRIX24_WEBHOOK_URL=
BITRIX24_ASSIGNED_BY_ID=
