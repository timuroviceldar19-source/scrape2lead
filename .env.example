# Госзакупки Казахстана
GOSZAKUP_TOKEN=
GOSZAKUP_HTML_MAX_PAGES=50
GOSZAKUP_PLAN_MAX_PAGES=50
GOSZAKUP_REGISTRY_CACHE_TTL_DAYS=7
GOSZAKUP_PLAN_DETAIL_CACHE_TTL_DAYS=7
GOSZAKUP_PLAN_DETAIL_FORCE_REFRESH=
KZ_ENRICH_DELAY_MS=2000
KZ_DATABASE_PATH=data/scrape2lead.db

# Автоматическое решение reCAPTCHA v2 в сервисах КГД
CAPSOLVER_API_KEY=

# Bitrix24
# Пример: https://your-domain.bitrix24.kz/rest/1/webhook-token/
BITRIX24_WEBHOOK_URL=
BITRIX24_ASSIGNED_BY_ID=
BITRIX24_NOTIFY_WEBHOOK_URL=
BITRIX24_NOTIFY_DIALOG_ID=

# AI-анализ технических спецификаций
SPEC_ANALYSIS_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=mimo-v2.5-free
SPEC_ANALYSIS_FALLBACK_API_KEY=
SPEC_ANALYSIS_FALLBACK_BASE_URL=https://opencode.ai/zen/go/v1
SPEC_ANALYSIS_FALLBACK_MODEL=kimi-k2.6

# Универсальные CLOUD_* можно использовать вместо OPENCODE_*/ANTHROPIC_*.
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=

# Poppler PDF renderer
PDFINFO_PATH=
PDFTOPPM_PATH=
SPEC_PDF_TEMP_DIR=tmp/spec-pdf
SPEC_PDF_MAX_PAGES=30
SPEC_PDF_DPI=150
SPEC_PDF_JPEG_QUALITY=88

# Альтернативный Anthropic native-PDF режим
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
SPEC_ANALYSIS_MODEL=claude-sonnet-5

# Чат-бот-помощник в Bitrix24 (src/assistant, npm run assistant).
# Ключ Claude API берётся из ANTHROPIC_API_KEY выше.
# Два отдельных входящих вебхука Bitrix24: BITRIX_BOT_WEBHOOK_URL с правом imbot и BITRIX_CRM_WEBHOOK_URL с правом crm.
ASSISTANT_MODEL=claude-haiku-5-5
BITRIX_CRM_WEBHOOK_URL=
BITRIX_BOT_WEBHOOK_URL=
BITRIX_BOT_TOKEN=
BITRIX_BOT_ID=
# Номера сотрудников через запятую или * для всех сотрудников портала (гости и боты не допускаются)
ASSISTANT_ALLOWED_USER_IDS=
ASSISTANT_DAILY_LIMIT_PER_USER=30
ASSISTANT_DAILY_LIMIT_TOTAL=200
